---
layout: layouts/base.njk
---
{% from "partials/icones.njk" import icone %}

{% include "partials/schema-servico.njk" %}

<section class="service-hero" data-bg="{{ servico.textoDecorativo }}">
  <div class="container service-hero-grid">
    <div class="service-hero-copy reveal">
      <span class="local-tag">
        <i></i> {{ servico.tag or "Serviço especializado" }}
      </span>

      <h1>{{ servico.h1 }}</h1>

      <p class="lead">
        {{ servico.heroTexto }}
      </p>

      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href="https://wa.me/{{ site.whatsapp }}?text={{ servico.whatsappMensagem | urlencode }}"
          target="_blank"
          rel="noopener"
        >
          {{ servico.ctaPrincipal or "Pedir orçamento" }}
        </a>

        <a class="btn btn-outline" href="#como-funciona">
          {{ servico.ctaSecundario or "Como funciona" }}
        </a>
      </div>
    </div>

    <div class="service-hero-card reveal">
      {% if servico.imagem %}
        <img
          src="{{ servico.imagem }}"
          alt="{{ servico.imagemAlt or servico.h1 }}"
          width="{{ servico.imagemLargura or 1200 }}"
          height="{{ servico.imagemAltura or 900 }}"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <div class="media-placeholder" role="img" aria-label="{{ servico.imagemAlt or servico.h1 }}"></div>
      {% endif %}

      <div class="service-hero-badge">
        <strong>{{ servico.nome }}</strong>
        <span>{{ site.empresa }}</span>
      </div>
    </div>
  </div>
</section>

{% include "partials/faixa-confianca.njk" %}

<section class="section service-intro">
  <div class="container intro-grid">
    <aside class="intro-aside reveal">
      <strong>Indicado para</strong>

      <div class="local-data">
        {% for item in servico.indicadoPara %}
          <div>
            <i>{{ icone("check") }}</i>
            <span>
              <b>{{ item.titulo }}</b>
              <span>{{ item.texto }}</span>
            </span>
          </div>
        {% endfor %}
      </div>
    </aside>

    <div class="intro-copy reveal">
      <h2>{{ servico.introTitulo }}</h2>

      {% for paragrafo in servico.introParagrafos %}
        <p>{{ paragrafo }}</p>
      {% endfor %}

      {% if servico.foto and servico.foto != servico.imagem %}
        <img class="card-photo" src="{{ servico.foto }}" alt="{{ servico.fotoAlt }}" width="800" height="498" loading="lazy" decoding="async">
      {% endif %}
    </div>
  </div>
</section>

<section class="section institutional-band">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ servico.sinaisTitulo or "Quando chamar um caça vazamento?" }}</h2>
      <p class="lead">
        {{ servico.sinaisTexto }}
      </p>
    </div>

    <div class="institutional-card-grid">
      {% for sinal in servico.sinais %}
        <article class="institutional-service-card reveal">
          <span>{{ loop.index }}</span>
          <h3>{{ sinal.titulo }}</h3>
          <p>{{ sinal.texto }}</p>
        </article>
      {% endfor %}
    </div>

    <div class="section-cta reveal">
      <a class="btn btn-primary" href="https://wa.me/{{ site.whatsapp }}?text={{ servico.whatsappMensagem | urlencode }}" target="_blank" rel="noopener">Falar com um técnico</a>
    </div>
  </div>
</section>

{% set etapas = servico.etapas %}
{% set processoTitulo = servico.processoTitulo %}
{% set processoTexto = servico.processoTexto %}
{% set whatsappMensagem = servico.whatsappMensagem %}
{% include "partials/como-funciona.njk" %}

<section class="quote-strip quote-strip-section">
  <div class="container quote-layout">
    <div class="quote-title">
      <strong>Solicite orientação inicial</strong>
      <span>O formulário abre uma conversa no WhatsApp.</span>
    </div>

    <form
      novalidate
      class="quote-form"
      id="serviceForm"
      data-servico="{{ servico.nome }}"
      data-whatsapp="{{ site.whatsapp }}"
    >
      <div class="field">
        <label for="serviceName">Nome</label>
        <input id="serviceName" type="text" autocomplete="name" placeholder="Seu nome" required>
      </div>

      <div class="field">
        <label for="serviceDistrict">Bairro</label>
        <input id="serviceDistrict" type="text" placeholder="Seu bairro" required>
      </div>

      <div class="field">
        <label for="serviceProperty">Tipo de imóvel</label>
        <select id="serviceProperty" required>
          <option value="">Selecione</option>
          <option>Casa</option>
          <option>Apartamento</option>
          <option>Condomínio</option>
          <option>Comércio</option>
          <option>Empresa</option>
          <option>Outro</option>
        </select>
      </div>

      <button class="btn btn-primary" type="submit">
        Consultar atendimento
      </button>
    </form>
  </div>
</section>

<section class="section service-coverage">
  <div class="container institutional-split">
    <div class="reveal">
      <h2>{{ servico.locaisTitulo or "Atendimento em residências, condomínios e empresas." }}</h2>

      <p class="lead">
        {{ servico.locaisTexto }}
      </p>

      <div class="chip-list">
        {% for local in servico.locais %}
          <span>{{ local.nome }}</span>
        {% endfor %}
      </div>
    </div>

    <div class="reveal">
      <h3 class="region-title">{{ servico.regioesTitulo or ("Atendimento em " + site.cidade + ".") }}</h3>
      <p>{{ servico.regioesTexto }}</p>

      <ul class="region-links">
        {% for item in bairros %}
          <li><a href="/{{ item.slug }}/">{{ item.nome }} <small>{{ item.regiao }}</small> {{ icone("seta") }}</a></li>
        {% endfor %}
        <li><a href="/onde-atendemos/">Todas as regiões {{ icone("seta") }}</a></li>
      </ul>
    </div>
  </div>
</section>

{% set faqItens = servico.faq %}
{% set faqTitulo = "Perguntas sobre " + (servico.nome | lower) + "." %}
{% include "partials/faq.njk" %}

<section class="final-cta" data-bg="{{ servico.textoDecorativo }}">
  <div class="container cta-grid">
    <div>
      <h2>{{ servico.ctaFinalTitulo }}</h2>

      <p>
        {{ servico.ctaFinalTexto }}
      </p>
    </div>

    <div>
      <a
        class="btn btn-primary"
        href="https://wa.me/{{ site.whatsapp }}?text={{ servico.whatsappMensagem | urlencode }}"
        target="_blank"
        rel="noopener"
      >
        Pedir orçamento
      </a>
    </div>
  </div>
</section>
