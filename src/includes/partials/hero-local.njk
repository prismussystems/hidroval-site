{% from "partials/icones.njk" import icone %}
<section class="local-hero" id="inicio" data-bg="{{ bairro.textoDecorativo }}">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="local-tag">
        <i></i> {{ bairro.tag or "Atendimento disponível na região" }}
      </span>

      <h1>{{ bairro.h1 }}</h1>

      <p class="lead">
        {{ bairro.heroTexto }}
      </p>

      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href="https://wa.me/{{ site.whatsapp }}?text={{ bairro.whatsappMensagem | urlencode }}"
          target="_blank"
          rel="noopener"
        >
          {{ bairro.ctaPrincipal or "Pedir orçamento" }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>

        <a class="btn btn-outline" href="#cobertura">
          {{ bairro.ctaSecundario or "Ver região atendida" }}
        </a>
      </div>

    </div>

    <div class="hero-visual reveal">
      <div class="hero-image">
        {% set heroBairro = bairro.heroImagem or site.heroBairroImagem %}
        {% if heroBairro %}
          <img src="{{ heroBairro }}" alt="Rua residencial arborizada com casas e prédios, região atendida {{ bairro.em or "em" }} {{ bairro.nome }}" width="1600" height="1200" loading="eager" fetchpriority="high">
        {% else %}
          <div class="media-placeholder" role="img" aria-label="{{ site.empresa }}"></div>
        {% endif %}
      </div>

      <div class="coverage-stamp">
        <div>
          <strong>{{ bairro.nome }}</strong>
          <span>e bairros próximos</span>
        </div>
      </div>

      <div class="local-card">
        <div class="local-card-copy">
          <small>Cobertura local</small>
          <h3>Atendimento {{ bairro.em or "em" }} {{ bairro.nome }}</h3>
          <p>Informe sua rua, condomínio ou ponto de referência para confirmar a disponibilidade da equipe.</p>
        </div>
      </div>
    </div>
  </div>
</section>