<section class="section local-intro">
  <div class="container intro-grid">
    <aside class="intro-aside reveal">
      <strong>Informações desta página</strong>

      <div class="local-data">
        <div>
          <i>⌖</i>
          <span>
            <b>Região</b>
            <span>{{ bairro.nome }}, {{ bairro.regiao }}</span>
          </span>
        </div>

        <div>
          <i>⌂</i>
          <span>
            <b>Imóveis atendidos</b>
            <span>Casas, apartamentos, condomínios, comércios e empresas</span>
          </span>
        </div>

        <div>
          <i>◷</i>
          <span>
            <b>Disponibilidade</b>
            <span>{{ site.atendimento }}</span>
          </span>
        </div>

        <div>
          <i>☎</i>
          <span>
            <b>Contato</b>
            <span>{{ site.telefone }}</span>
          </span>
        </div>
      </div>
    </aside>

    <div class="intro-copy reveal">

      <h2>{{ bairro.introTitulo }}</h2>

      {% for paragrafo in bairro.introParagrafos %}
        <p>{{ paragrafo }}</p>
      {% endfor %}

      <div class="local-highlights">
        <div class="highlight">
          <strong>Geofone</strong>
          <span>localização precisa de vazamentos ocultos</span>
        </div>

        <div class="highlight">
          <strong>Sem quebra</strong>
          <span>abertura apenas no ponto do reparo</span>
        </div>

        <div class="highlight">
          <strong>Local</strong>
          <span>orçamento direcionado para {{ bairro.nome }}</span>
        </div>
      </div>
    </div>
  </div>
</section>