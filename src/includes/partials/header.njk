<header class="header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="{{ site.empresa }} - página inicial">
      <img src="/assets/img/logo-imuniziprag.webp" alt="{{ site.empresa }}">
    </a>

    <nav class="nav-links" aria-label="Navegação principal">
      {% for item in menu.institucional %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>

    <div class="nav-actions">
      <a class="phone" href="tel:{{ site.telefoneLink }}">
        <small>Fale agora</small>
        <strong>{{ site.telefone }}</strong>
      </a>

      <a class="btn btn-primary" href="{{ menu.cta.url }}" target="_blank" rel="noopener">
        {{ menu.cta.label }}
      </a>

      <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>