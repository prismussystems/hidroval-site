<footer>
  <div class="container footer-main">
    <div class="footer-brand">
      <img src="/assets/img/hidroval-logo-branco.webp" alt="{{ site.empresa }}" width="600" height="208" loading="lazy" decoding="async">

      <p>
        {{ site.descricaoPadrao }}
      </p>

      <a class="btn btn-primary" href="tel:{{ site.telefoneLink }}">
        {{ site.telefone }}
      </a>
    </div>

    <div class="footer-col">
      <strong>Serviços</strong>
      {% for item in servicos %}
        <a href="/{{ item.slug }}/">{{ item.nome }}</a>
      {% endfor %}
    </div>

    <div class="footer-col">
      <strong>Onde atendemos</strong>
      {% for item in bairros %}
        <a href="/{{ item.slug }}/">{{ item.nome }}</a>
      {% endfor %}
      <a href="/onde-atendemos/">Todas as regiões</a>
    </div>

    <div class="footer-col">
      <strong>Contato</strong>
      <a href="tel:{{ site.telefoneLink }}">{{ site.telefone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMensagem | urlencode }}" target="_blank" rel="noopener">Fale conosco pelo WhatsApp</a>
      <p>{{ site.endereco }}</p>
      <p>{{ site.atendimento }}</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© <span id="year"></span> {{ site.empresa }}. Todos os direitos reservados.</span>
    <span>CNPJ {{ site.cnpj }}</span>
  </div>
</footer>