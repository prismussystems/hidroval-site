<section class="quote-strip">
  <div class="container quote-layout">
    <div class="quote-title">
      <strong>Solicite uma orientação inicial</strong>
      <span>O formulário abre uma conversa no WhatsApp.</span>
    </div>

    <form
      novalidate
      class="quote-form"
      id="localForm"
      data-bairro="{{ bairro.nome }}"
      data-whatsapp="{{ site.whatsapp }}"
    >
      <div class="field">
        <label for="name">Nome</label>
        <input id="name" type="text" autocomplete="name" placeholder="Seu nome" required>
      </div>

      <div class="field">
        <label for="street">Rua ou ponto de referência</label>
        <input id="street" type="text" autocomplete="street-address" placeholder="Ex.: Rua Tal, 100" required>
      </div>

      <div class="field">
        <label for="problem">Tipo de problema</label>
        <select id="problem" required>
          <option value="">Selecione</option>
          {% include "partials/opcoes-problema.njk" %}
        </select>
      </div>

      <button class="btn btn-primary" type="submit">
        Consultar atendimento
      </button>
    </form>
  </div>
</section>
