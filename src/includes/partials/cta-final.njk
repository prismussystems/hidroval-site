<section class="final-cta" data-bg="{{ bairro.textoDecorativo }}">
  <div class="container cta-grid">
    <div>
      <h2>Precisa de um caça vazamento {{ bairro.em or "em" }} {{ bairro.nome }}?</h2>

      <p>
        Cada dia de vazamento é água desperdiçada e mais estrago no imóvel. Fale com a {{ site.empresa }} pelo WhatsApp, informe sua rua ou ponto de referência {{ bairro.em or "em" }} {{ bairro.nome }} e receba orientação.
      </p>
    </div>

    <div>
      <a
        class="btn btn-primary"
        href="https://wa.me/{{ site.whatsapp }}?text={{ bairro.whatsappMensagem | urlencode }}"
        target="_blank"
        rel="noopener"
      >
        Pedir orçamento
      </a>
    </div>
  </div>
</section>